<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox alignment="CENTER" prefHeight="300.0" prefWidth="450.0" spacing="10.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.bignumsjavafx261009.HelloController" >
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>

    <TextField fx:id="display" prefHeight="51.0" prefWidth="396.0" style="-fx-font-size: 24px;" />

    <GridPane alignment="CENTER" hgap="10.0" vgap="10.0">
        <columnConstraints>
            <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
            <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
            <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
            <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
            <ColumnConstraints />
        </columnConstraints>
        <rowConstraints>
            <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
            <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
            <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
            <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
            <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
        </rowConstraints>

        <Button fx:id="btn7" onAction="#handleDigitClick" minWidth="100.0" style="-fx-font-size: 18px;" text="7" GridPane.columnIndex="0" GridPane.rowIndex="0" />
        <Button fx:id="btn8" onAction="#handleDigitClick" minWidth="100.0" style="-fx-font-size: 18px;" text="8" GridPane.columnIndex="1" GridPane.rowIndex="0" />
        <Button fx:id="btn9" onAction="#handleDigitClick" minWidth="100.0" style="-fx-font-size: 18px;" text="9" GridPane.columnIndex="2" GridPane.rowIndex="0" />
        <Button fx:id="btnDivide" minWidth="100.0" style="-fx-font-size: 18px;" text="/" GridPane.columnIndex="3" GridPane.rowIndex="3" />

        <Button fx:id="btn4" onAction="#handleDigitClick" minWidth="100.0" style="-fx-font-size: 18px;" text="4" GridPane.columnIndex="0" GridPane.rowIndex="1" />
        <Button fx:id="btn5" onAction="#handleDigitClick" minWidth="100.0" style="-fx-font-size: 18px;" text="5" GridPane.columnIndex="1" GridPane.rowIndex="1" />
        <Button fx:id="btn6" onAction="#handleDigitClick" minWidth="100.0" style="-fx-font-size: 18px;" text="6" GridPane.columnIndex="2" GridPane.rowIndex="1" />
        <Button fx:id="btnMultiply" minWidth="100.0" style="-fx-font-size: 18px;" text="*" GridPane.columnIndex="3" GridPane.rowIndex="2" />

        <Button fx:id="btn1" onAction="#handleDigitClick" minWidth="100.0" style="-fx-font-size: 18px;" text="1" GridPane.columnIndex="0" GridPane.rowIndex="2" />
        <Button fx:id="btn2" onAction="#handleDigitClick" minWidth="100.0" style="-fx-font-size: 18px;" text="2" GridPane.columnIndex="1" GridPane.rowIndex="2" />
        <Button fx:id="btn3" onAction="#handleDigitClick" minWidth="100.0" style="-fx-font-size: 18px;" text="3" GridPane.columnIndex="2" GridPane.rowIndex="2" />
        <Button fx:id="btnSubtract" minWidth="100.0" style="-fx-font-size: 18px;" text="-" GridPane.columnIndex="3" GridPane.rowIndex="1" />

        <Button fx:id="btn0" onAction="#handleDigitClick" minWidth="100.0" style="-fx-font-size: 18px;" text="0" GridPane.columnIndex="0" GridPane.columnSpan="2" GridPane.rowIndex="3" />
        <Button fx:id="btnDecimal" disable="true" minWidth="100.0" style="-fx-font-size: 18px;" text="." GridPane.columnIndex="2" GridPane.rowIndex="3" />
        <Button fx:id="btnAdd" onAction="#handleAddClick" minWidth="100.0" style="-fx-font-size: 18px;" text="+" GridPane.columnIndex="3" />

        <Button fx:id="btnClear" minWidth="100.0" style="-fx-font-size: 18px;" text="C" GridPane.columnIndex="1" GridPane.columnSpan="2" GridPane.rowIndex="3" />
        <Button fx:id="btnEquals" onAction="#handleEqualsClick" minWidth="100.0" style="-fx-font-size: 18px;" text="=" GridPane.columnIndex="3" GridPane.columnSpan="2" GridPane.rowIndex="4" />
    </GridPane>
</VBox>